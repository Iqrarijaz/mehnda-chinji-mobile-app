# API URL (e.g., https://api.yourdomain.com)
EXPO_PUBLIC_API_URL=

# Sentry Configuration
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ORG=
EXPO_PUBLIC_SENTRY_PROJECT=

# AdMob (Currency Exchange "watch ad to unlock" flow).
# Leave blank to use Google's official test IDs (dev-safe fallback baked
# into app.config.js / constants/ads.ts). Required before a production
# release — Google prohibits shipping test IDs to prod.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_IOS=
