{
  "expo": {
    "name": "Rehbar",
    "slug": "rehbar",
    "version": "2.0.8",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "scheme": "rehbarcommunityapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E6F4FE",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rehbar.community",
      "buildNumber": "18",
      "icon": "./public/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to take profile and support ticket photos.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to use your location to send accurate local weather notifications for your area."
      }
    },
    "android": {
      "package": "com.rehbar.community",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./public/icon.png",
        "backgroundImage": "./public/icon.png",
        "monochromeImage": "./public/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.rehbarapp.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./public/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to send accurate local weather notifications for your area."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./public/logo.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/azaan.mp3"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "extraPods": [
              {
                "name": "GoogleMobileAdsMediationAppLovin",
                "version": "13.0.1.0"
              },
              {
                "name": "GoogleMobileAdsMediationFacebook",
                "version": "6.15.2.0"
              },
              {
                "name": "GoogleMobileAdsMediationUnity",
                "version": "4.12.3.0"
              }
            ]
          },
          "android": {
            "kotlinVersion": "2.2.10",
            "enableProguardInReleaseBuilds": true,
            "dependencies": [
              "com.google.ads.mediation:applovin:13.1.0.0",
              "com.google.ads.mediation:facebook:6.19.0.0",
              "com.google.ads.mediation:unity:4.13.2.0"
            ]
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1707254546231644~1553611625",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f630327-41c2-4baa-a864-6fe5e42862f6"
      }
    },
    "owner": "iqrarijaz788"
  }
}