{
  "expo": {
    "name": "Rehbar",
    "slug": "rehbar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "scheme": "rehbarcommunityapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./public/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to access your location to show weather information and local services.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to take profile and support ticket photos."
      }
    },
    "android": {
      "package": "com.rehbar.community",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon.png",
        "backgroundImage": "./public/icon.png",
        "monochromeImage": "./public/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./android/app/google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./public/icon.png"
    },
    "splash": {
      "image": "./public/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f630327-41c2-4baa-a864-6fe5e42862f6"
      }
    },
    "owner": "iqrarijaz788"
  }
}
