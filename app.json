{
  "expo": {
    "name": "Rehbar",
    "slug": "rehbar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "scheme": "rehbarcommunityapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rehbar.community",
      "buildNumber": "1",
      "icon": "./public/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to take profile and support ticket photos."
      }
    },
    "android": {
      "package": "com.rehbar.community",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/icon.png",
        "backgroundImage": "./public/icon.png",
        "monochromeImage": "./public/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.rehbarapp.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./public/icon.png"
    },
    "splash": {
      "image": "./public/logo_with_text.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/azaan.mp3"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "948924501214677",
          "clientToken": "825272e9f513e247f25247b374a936f2",
          "displayName": "Rehbar",
          "scheme": "fb948924501214677",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f630327-41c2-4baa-a864-6fe5e42862f6"
      }
    },
    "owner": "iqrarijaz788"
  }
}